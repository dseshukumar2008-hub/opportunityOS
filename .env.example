# OpportunityOS Environment Configuration

# 1. Firebase Configuration (REQUIRED)
# These keys are required to connect to the Firebase project for Authentication and Firestore.
# They are public client keys, not sensitive secrets, and are safe to bundle in the Vite frontend.
VITE_FIREBASE_API_KEY="your-firebase-api-key"

# 2. External API Configuration (OPTIONAL)
# Used for backend AI services. If empty or unreachable, the application falls back to offline templates.
VITE_API_BASE_URL="http://localhost:8080"
